<details name="index">
  <summary>
    <h2>Unkonf 2025</h2>
  </summary>
  <div class="details-content">
    <ol class="indexlist">
      {% for i in collections.unkonf25 %}
        <li>
          <a href="{{ i.url }}" target="_blank">{{ i.data.title }}</a>
        </li>
      {% endfor %}
    </ol>
  </div>
</details>
