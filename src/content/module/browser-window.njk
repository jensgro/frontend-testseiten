    This one shows http:// because eww, gross.
  </browser-window>
  <browser-window
    url="https://www.zachleat.com/web/really-long-url-that-should-be-ellipsesed-really-long-url-that-should-be-ellipsesed-really-long-url-that-should-be-ellipsesed-really-long-url-that-should-be-ellipsesed"
    icon>
